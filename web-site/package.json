{
  "name": "yamakage-site",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "deploy": "npx wrangler pages deploy dist",
    "test": "vitest",
    "test:ci": "vitest run",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm run lint:ci && pnpm run typecheck && pnpm run test:ci"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "tz-lookup": "^6.1.25",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "~3.2.0"
  }
}
