# ========================================
# YAMAKAGE Environment Variables (.env.example)
# ========================================

# Target Garmin device product identifier (e.g., edge1030, edge1040)
GARMIN_DEVICE=

# Absolute or relative path to the Garmin developer private key (.der) for signing
GARMIN_KEY_PATH=

# Path to the Garmin Connect IQ SDK binary/bin directory (if required for build scripts)
GARMIN_SDK_BIN=